<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Cofetaria Dulcelind ofera prajituri, torturi, produse de patiserie cu optiunea de achizitie online si livrare prin curier.">
        <meta name="keywords" content="cofetarie, Dulcelind, prajituri, torturi, dulce, pateuri, produse">
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <title>Culinaro - Produse</title>
        <%- include("../fragmente/head") %>     
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src=/resurse/js/produse-cos.js></script>
        <link rel="stylesheet" type="text/css" href="/resurse/css/produse.css"> 
    </head>
    <body>


    <%- include("../fragmente/header") %>

    <main class="layout-produse">
        
        <aside class="filtre-fixed">
            <h3>Filtre</h3>
            <div class="row g-3">
                <!-- Nume - Form control clasic in Grid -->
                <div class="col-12">
                    <label for="inp-nume" class="form-label">Nume:</label>
                    <!-- input 1 BD -->
                    <input type="text" id="inp-nume" class="form-control" placeholder="ex: cuptor" maxlength="<%- locals.maxNumeLen %>">
                </div>
            
                <!-- Textarea cu Floating Label și Invalid Feedback -->
                <div class="col-12">
                    <div class="form-floating">
                        <!-- input 2 BD -->
                        <textarea class="form-control" id="inp-descriere" placeholder="Caută în descriere..." style="height: 80px" maxlength="<%- locals.maxDescLen %>"></textarea> 
                        <label for="inp-descriere">Cuvânt în descriere</label>
                        <div class="invalid-feedback">
                            Textul conține caractere invalide (< sau >)!
                        </div>
                    </div>
                </div>

                <!-- Datalist -->
                <div class="col-12">
                    <label for="inp-material" class="form-label">Material:</label>
                    <input class="form-control" list="lista-materiale" id="inp-material" placeholder="Orice material">
                    <!-- input 3 bd -->
                    <datalist id="lista-materiale">   
                        <% for(let mat of locals.materiale) { %>
                            <option value="<%- mat.material %>">
                        <% } %>
                    </datalist>
                </div>                                   

                <!-- Garanție - Grup de Toggle Buttons (Radios) -->
                <div class="col-12">
                    <label class="form-label d-block">Garanție:</label>
                    <div class="btn-group w-100" role="group" style="flex-wrap: wrap;">
                        <input type="radio" class="btn-check" name="gr_rad" id="i_rad_toate" value="toate" autocomplete="off" checked>
                        <label class="btn btn-outline-primary btn-sm" for="i_rad_toate">Toate</label>
                        <!-- input 4 bd -->
                        <% for(let i=0; i<locals.garantii.length; i++) { %>
                            <input type="radio" class="btn-check" name="gr_rad" id="i_rad_<%- i %>" value="<%- locals.garantii[i].perioada_garantie %>" autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="i_rad_<%- i %>"><%- locals.garantii[i].perioada_garantie %></label>
                        <% } %>
                    </div>
                </div>

                <!-- Uz Profesional - Toggle Button (Checkbox) -->
                <div class="col-12">
                    <input type="checkbox" class="btn-check" id="inp-profesional" autocomplete="off">
                    <label class="btn btn-outline-secondary w-100" for="inp-profesional">Doar uz profesional</label>
                </div>

                <!-- Preț Range -->
                <div class="col-12">
                    <!-- input 5 bd  -->
                    <label for="inp-pret-min" class="form-label">Preț minim: <span id="infoRangeMin">(<%- locals.minPret %>)</span></label>
                    <input type="range" class="form-range" id="inp-pret-min" value="<%- locals.minPret %>" min="<%- locals.minPret %>" max="<%- locals.maxPret %>">
                    <!-- input 6 bd  -->
                    <label for="inp-pret-max" class="form-label mt-2">Preț maxim: <span id="infoRangeMax">(<%- locals.maxPret %>)</span></label>
                    <input type="range" class="form-range" id="inp-pret-max" value="<%- locals.maxPret %>" min="<%- locals.minPret %>" max="<%- locals.maxPret %>">
                </div>

                <!-- Select Simplu -->
                <div class="col-12">
                    <label for="inp-categorie" class="form-label">Categorie:</label>
                    <select class="form-select" id="inp-categorie">
                        <option id="sel-toate" selected value="toate">Toate (oricare)</option>
                        <!-- input 7 bd -->
                        <% if (locals.optiuniMeniu) { %>
                            <% for (let opt of locals.optiuniMeniu) { %>
                                <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                            <% } %>
                        <% } %>
                    </select>
                </div>

                <!-- Select Multiplu -->
                <div class="col-12">
                    <label for="inp-alimentare" class="form-label">Tip alimentare:</label>
                    <!-- input 8 bd -->
                    <select class="form-select" id="inp-alimentare" multiple size="4">
                        <option value="toate" selected>Oricare (Toate)</option>
                        <% for(let alim of locals.alimentari) { %>
                            <option value="<%- alim.tip_alimentare %>"><%- alim.tip_alimentare %></option>
                        <% } %>
                    </select>
                </div>

                <!-- Butoane de acțiune cu Icoane și clase Bootstrap responsive -->
                <div class="col-12 container-butoane-filtre mt-4">
                    <button id="filtrare" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-funnel"></i> <span class="d-none d-md-inline">Filtrează</span>
                    </button> 
                    <button id="resetare" class="btn btn-outline-danger w-100 mt-2">
                        <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-md-inline">Resetează</span>
                    </button>
                    <div class="d-flex gap-2 mt-2">
                        <button id="sortCrescNume" class="btn btn-secondary flex-fill">
                            <i class="bi bi-sort-alpha-down"></i> <span class="d-none d-md-inline">Crescător</span>
                        </button>
                        <button id="sortDescrescNume" class="btn btn-secondary flex-fill">
                            <i class="bi bi-sort-alpha-up-alt"></i> <span class="d-none d-md-inline">Descrescător</span>
                        </button>
                    </div>
                    <button id="calculare" class="btn btn-success w-100 mt-2">
                        <i class="bi bi-calculator"></i> <span class="d-none d-md-inline">Calculează Suma</span>
                    </button>
                </div>
            </div>
        </aside>
  
        <section id="produse" class="lista-produse">

            <h2>Produse</h2>
            <div id="container-paginare" style="margin-bottom: 20px; text-align: center; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
            </div>
            <div class="grid-produse">
    <% for( let prod of locals.produse) { %>
        <article id="art<%- prod.id %>" class="produs <%- prod.categorie %>">
            
            <h3 class="nume">
                <a href="/produs/<%- prod.id %>"><span class="val-nume"><%- prod.nume %></span></a>
            </h3>
            
            <p class="categorie">Categorie: <span class="val-categorie"><%- prod.categorie %></span></p>
            
            <p class="descriere"><%- prod.descriere %></p>

            <div class="detalii-produs">
                
                <figure class="fig-imagine-produs">
                    <a href="/produs/<%- prod.id %>">
                        <img src="/resurse/imagini/produse/<%- prod.imagine %>" alt="Imagine <%- prod.nume %>" />
                    </a>
                </figure>

                <table class="tabel-caracteristici">
                    <tbody>
                        <tr>
                            <td><strong>Garanție:</strong></td>
                            <td><span class="val-garantie"><%- prod.perioada_garantie %></span> luni</td>
                        </tr>
                        <tr>
                            <td><strong>Material:</strong></td>
                            <td><span class="val-material"><%- prod.material %></span></td>
                        </tr>
                        <tr>
                            <td><strong>Funcții incluse:</strong></td>
                            <td><span class="val-functii"><%- prod.functii_incluse %></span></td>
                        </tr>
                        <tr>
                            <td><strong>Adăugat la:</strong></td>
                            <td>
                                <% 
                                    let dataProd = new Date(prod.data_adaugare);
                                    let zile = ['Duminica', 'Luni', 'Marti', 'Miercuri', 'Joi', 'Vineri', 'Sambata'];
                                    let luni = ['Ianuarie', 'Februarie', 'Martie', 'Aprilie', 'Mai', 'Iunie', 'Iulie', 'August', 'Septembrie', 'Octombrie', 'Noiembrie', 'Decembrie'];
                                    
                                    let zi = dataProd.getDate();
                                    let numeLuna = luni[dataProd.getMonth()];
                                    let an = dataProd.getFullYear();
                                    let numeZi = zile[dataProd.getDay()];
                                    
                                    let dataFormatata = zi + '/' + numeLuna + '/' + an + ' (' + numeZi + ')';
                                    let dataMachine = dataProd.toISOString().split('T')[0]; // Formatul YYYY-MM-DD pt atributul datetime
                                %>
                                <time datetime="<%- dataMachine %>" class="val-data"><%- dataFormatata %></time>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Alimentare:</strong></td>
                            <td><span class="val-alimentare"><%- prod.tip_alimentare %></span></td>
                        </tr>
                        <tr>
                            <td><strong>Uz Profesional:</strong></td>
                            <td><span class="val-profesional"><%- prod.este_profesional ? 'Da' : 'Nu' %></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="container-pret-cos">
                <p class="pret">Preț: <span class="val-pret"><%- prod.pret %></span> Lei</p>
                <label class="selecteaza-cos">
                    Adaugă în coș: <input type="checkbox" class="select-cos" value="<%- prod.id %>" autocomplete="off">
                </label>
            </div>
            
        </article>
    <% } %>
</div>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>